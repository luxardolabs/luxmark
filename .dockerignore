# Git
**/.git
.gitignore

# Documentation (not needed in image)
docs/
README*.md
CONTRIBUTING.md
CHANGELOG.md
LICENSE

# Docker files
Dockerfile
compose*.yml
.dockerignore

# Secrets, at ANY depth (a bare pattern here matches only the context root): dotenv files,
# credentials, keys. Nothing the image serves is one of these.
**/.env
**/.env.*
**/*.env
**/*credentials.json
**/*.pem
**/id_rsa*
**/id_ecdsa*
**/id_ed25519*

# OS files
**/.DS_Store
**/Thumbs.db

# IDE files
.vscode/
.idea/
**/*.swp
**/*.swo

# Logs
**/*.log

# Node (if added later)
node_modules/
**/npm-debug.log*

# Every file pattern .gitignore ignores, at ANY depth (a bare pattern here matches only the root).
# `git status` never lists an ignored file, so the release's clean-tree check cannot see one, yet it
# is in the build context: a stray `src/js/notes.tmp` was served by the released image.
# tests/supply-chain.test.js locks this list against .gitignore.
**/.build.env
**/*.tmp
**/*.temp
**/test.html
**/*.py[cod]
**/*.pyc
**/*.pyo
**/__pycache__/
