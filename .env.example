# luxmark deploy settings — copy to .env and set TAG. Never commit .env.
#
# TAG is REQUIRED and has no default on purpose: compose uses ${TAG:?}, so a missing value fails
# loudly rather than quietly deploying whatever `latest` happens to point at.
TAG=2026.10.0

# The registry/repository half of the image reference. Defaults to the public GHCR copy; set it to
# deploy the same build from another registry (e.g. an internal one).
# LUXMARK_IMAGE=ghcr.io/luxardolabs/luxmark
#
# A DEV stack (`.env.dev`, written by `make dev-deploy` / `make dev-pin`) runs `:sha-<commit>` builds,
# which exist only in the private registry, never on GHCR. Its .env.dev must say so:
#   LUXMARK_IMAGE=<LUX_REGISTRY>/luxardolabs/luxmark
# and `make dev-pin` rolls back only to a published sha-<commit>: a release lives on GHCR.

# Host port to publish the page on.
# PORT=8080

# Host address the port is published on. Loopback by default (behind a reverse proxy, the proxy reaches
# the container over the docker network). Set 0.0.0.0 to serve the page directly to your LAN.
# LUXMARK_BIND=127.0.0.1
